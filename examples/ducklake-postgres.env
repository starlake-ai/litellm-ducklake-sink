# litellm-ducklake-sink: DuckLake with a Postgres catalog
#
#   cp examples/ducklake-postgres.env .env
#   set -a; . ./.env; set +a      # load it into the shell that starts LiteLLM
#
# LiteLLM writes into DuckLake itself: the catalog lives in Postgres and the
# data is Parquet in a folder. This is the setup for several proxy replicas:
# each one attaches the same catalog and writes to the same data folder.
#
# A Postgres to try it with (matches the values below):
#   docker run -d --name ducklake-pg -p 5432:5432 -e POSTGRES_USER=ducklake \
#     -e POSTGRES_PASSWORD=ducklake -e POSTGRES_DB=ducklake postgres:17
# Query while the proxy runs:
#   duckdb -c "ATTACH 'ducklake:postgres:dbname=ducklake host=localhost user=ducklake password=ducklake' AS lake (READ_ONLY); FROM lake.main.llm_requests"
#
# Every setting is spelled out with its default. An empty value means
# "not set". Relative paths are relative to the folder you start the proxy from.

# Master switch. false keeps the callback in config.yaml but fully inert:
# nothing below is read or validated.
DUCKLAKE_SINK_ENABLED=true

# ---------------------------------------------------------------------------
# The lake
# ---------------------------------------------------------------------------

# DuckLake catalog: postgres:<libpq connection string>, quoted because it has
# spaces. The database must exist; DuckLake creates its tables on first write.
DUCKLAKE_SINK_CATALOG="postgres:dbname=ducklake host=localhost port=5432 user=ducklake password=ducklake"

# Folder where DuckLake writes the Parquet files. With several replicas, use
# an absolute path to a folder they all share (for example a mounted volume).
# DuckLake records this value in the catalog on the first write and refuses a
# different one afterwards: every flush then fails and batches pile up in the
# spool, with a "does not match existing data path" warning in the proxy log.
DUCKLAKE_SINK_DATA_PATH=lake/data/

# Optional: keep the Parquet files on S3, or on an S3-compatible store such as
# MinIO or Cloudflare R2, by uncommenting this block. Do it on a new catalog:
# DuckLake refuses a DATA_PATH that differs from the one it recorded first.
# The sink creates a DuckDB secret for the bucket. Leave the two keys empty to
# use the AWS credential chain (AWS_* variables, ~/.aws, or the instance role).
# Defaults: every S3 setting empty, except DUCKLAKE_SINK_S3_USE_SSL=true.
#
# DUCKLAKE_SINK_DATA_PATH=s3://my-bucket/llm-lake/
# DUCKLAKE_SINK_S3_KEY_ID=
# DUCKLAKE_SINK_S3_SECRET=
# DUCKLAKE_SINK_S3_REGION=us-east-1
# # S3-compatible store only: its host:port, path-style URLs, and plain HTTP
# # if it has no TLS.
# DUCKLAKE_SINK_S3_ENDPOINT=localhost:9000
# DUCKLAKE_SINK_S3_URL_STYLE=path
# DUCKLAKE_SINK_S3_USE_SSL=false
# Schema that holds llm_requests and llm_payloads. main always exists.
DUCKLAKE_SINK_SCHEMA_NAME=main

# ---------------------------------------------------------------------------
# What is written, and how
# ---------------------------------------------------------------------------

# Also store prompts and responses in llm_payloads.
DUCKLAKE_SINK_CAPTURE_PAYLOADS=false
# Flush when this many requests are buffered...
DUCKLAKE_SINK_BATCH_ROWS=1000
# ...or every this many seconds...
DUCKLAKE_SINK_BATCH_INTERVAL=10
# ...or when the buffer reaches this many bytes (2 MiB).
DUCKLAKE_SINK_BATCH_MAX_BYTES=2097152
# Each payload text field is truncated to this many bytes (1 MiB).
DUCKLAKE_SINK_PAYLOAD_MAX_BYTES=1048576

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------

# Batches that cannot be written are kept here and replayed later.
# Empty means <system temp dir>/litellm_ducklake_spool. In a container,
# point it at a persistent volume.
DUCKLAKE_SINK_SPOOL_DIR=
# Spool cap (512 MiB). The oldest batches are dropped once it is full.
DUCKLAKE_SINK_SPOOL_MAX_BYTES=536870912
# Seconds to wait for the last flush at shutdown.
DUCKLAKE_SINK_DRAIN_TIMEOUT=10
# Write attempts per batch before it is spooled (backoff 1s, 2s, 4s... max 30s).
DUCKLAKE_SINK_FLUSH_MAX_ATTEMPTS=5
