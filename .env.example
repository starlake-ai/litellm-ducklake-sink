# litellm-ducklake-sink settings, with every default spelled out.
#
#   cp .env.example .env
#   set -a; . ./.env; set +a      # load it into the shell that starts LiteLLM
#
# Relative paths are relative to the folder you start the proxy from.
# An empty value means "not set". When a setting appears twice, the last
# line wins (the QoD block at the end relies on this).

# Master switch. false keeps the callback in config.yaml but fully inert:
# nothing below is read or validated.
DUCKLAKE_SINK_ENABLED=true

# ---------------------------------------------------------------------------
# Where telemetry lands: set CATALOG or ENDPOINT, never both.
# ---------------------------------------------------------------------------

# Direct: LiteLLM writes into DuckLake itself, with no server in between.
#   sqlite:<file>         local file, several processes on one host (this quickstart)
#   postgres:<libpq dsn>  e.g. postgres:dbname=lake host=db user=lake password=...
#                         for several proxy replicas
#   quack:<host>[:port]   a DuckDB server started with quack_serve holds the
#                         catalog; set DUCKLAKE_SINK_QUACK_TOKEN
#   <file>.ducklake       DuckDB file, one process only, locked while the proxy runs
DUCKLAKE_SINK_CATALOG=sqlite:lake/catalog.sqlite
# Folder where DuckLake writes the Parquet files. With several proxies, use
# a folder they all share.
DUCKLAKE_SINK_DATA_PATH=lake/data/

# Server: the lake is attached on a server and the sink sends it SQL.
#   quack:<host>:<port>   Quack protocol: a QoD gateway (see the QoD block below)
#                         or any DuckDB started with quack_serve
#   grpc+tls://<host>:<port>, grpc://<host>:<port>   Arrow Flight SQL
DUCKLAKE_SINK_ENDPOINT=
# Server credentials. Required for Flight SQL and for QoD over Quack.
DUCKLAKE_SINK_USERNAME=
DUCKLAKE_SINK_PASSWORD=
# Skip TLS certificate checks (Flight SQL only; self-signed test servers).
DUCKLAKE_SINK_TLS_SKIP_VERIFY=false

# Token printed by quack_serve: needed for a quack: CATALOG, and for a quack:
# ENDPOINT that is a plain DuckDB server. For QoD, leave it empty and the
# sink builds the token from the username, password, tenant and pool.
DUCKLAKE_SINK_QUACK_TOKEN=

# ---------------------------------------------------------------------------
# What is written, and how
# ---------------------------------------------------------------------------

# Schema that holds llm_requests and llm_payloads. It must already exist.
DUCKLAKE_SINK_SCHEMA_NAME=main
# Also store prompts and responses in llm_payloads.
DUCKLAKE_SINK_CAPTURE_PAYLOADS=false
# Flush when this many requests are buffered...
DUCKLAKE_SINK_BATCH_ROWS=1000
# ...or every this many seconds...
DUCKLAKE_SINK_BATCH_INTERVAL=10
# ...or when the buffer reaches this many bytes (2 MiB).
DUCKLAKE_SINK_BATCH_MAX_BYTES=2097152
# Each payload text field is truncated to this many bytes (1 MiB).
DUCKLAKE_SINK_PAYLOAD_MAX_BYTES=1048576

# ---------------------------------------------------------------------------
# Resilience
# ---------------------------------------------------------------------------

# Batches that cannot be written are kept here and replayed later.
# Empty means <system temp dir>/litellm_ducklake_spool. In a container,
# point it at a persistent volume.
DUCKLAKE_SINK_SPOOL_DIR=
# Spool cap (512 MiB). The oldest batches are dropped once it is full.
DUCKLAKE_SINK_SPOOL_MAX_BYTES=536870912
# Seconds to wait for the last flush at shutdown.
DUCKLAKE_SINK_DRAIN_TIMEOUT=10
# Write attempts per batch before it is spooled (backoff 1s, 2s, 4s... max 30s).
DUCKLAKE_SINK_FLUSH_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Retention (python -m litellm_ducklake_sink.retention)
# ---------------------------------------------------------------------------

# Rows older than this many days are deleted.
DUCKLAKE_SINK_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# QoD (quack-on-demand) only
# ---------------------------------------------------------------------------
# Defaults: these five settings are empty, and nothing but QoD reads them.
DUCKLAKE_SINK_TENANT=
DUCKLAKE_SINK_POOL=
DUCKLAKE_SINK_TENANT_DB=
DUCKLAKE_SINK_MAINTENANCE_URL=
DUCKLAKE_SINK_MAINTENANCE_API_KEY=

# To send telemetry to the `uvx qod start --demo` gateway instead of the local
# lake, uncomment this whole block. It switches every setting QoD needs.
#
# DUCKLAKE_SINK_CATALOG=
# DUCKLAKE_SINK_DATA_PATH=
# # QoD's native Quack front door. Flight SQL also works: grpc+tls://localhost:31338
# # with DUCKLAKE_SINK_TLS_SKIP_VERIFY=true.
# DUCKLAKE_SINK_ENDPOINT=quack:localhost:9494
# DUCKLAKE_SINK_USERNAME=acme-admin
# DUCKLAKE_SINK_PASSWORD=demo-acme-admin
# # Tenant and pool the gateway routes each statement to.
# DUCKLAKE_SINK_TENANT=acme
# DUCKLAKE_SINK_POOL=bi
# # Schema of the demo's tenant database.
# DUCKLAKE_SINK_SCHEMA_NAME=tpch1
# # Tenant database and manager REST endpoint: after retention deletes rows,
# # QoD's managed maintenance physically removes the old files.
# DUCKLAKE_SINK_TENANT_DB=acme_tpch
# DUCKLAKE_SINK_MAINTENANCE_URL=http://localhost:20900
# # API key for that endpoint, if the manager requires one.
# DUCKLAKE_SINK_MAINTENANCE_API_KEY=
